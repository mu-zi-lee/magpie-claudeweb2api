diff --git a/internal/provider/plugin_cleanremove.go b/internal/provider/plugin_cleanremove.go
new file mode 100644
index 0000000..369b763
--- /dev/null
+++ b/internal/provider/plugin_cleanremove.go
@@ -0,0 +1,75 @@
+package provider
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"slices"
+	"strings"
+
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/steady"
+)
+
+func init() { plugin.CleanRemoved = cleanRemovedPluginMetadata }
+
+// Only opt-in removals reach here. Account labels and provider overrides would
+// otherwise survive sign-out and become visible again on the next installation.
+func cleanRemovedPluginMetadata(ids []string) error {
+	owned := make(map[string]bool, len(ids))
+	mapped := make(map[string]bool, len(ids))
+	for _, id := range ids {
+		owned["plugin:"+id] = true
+		if !slices.Contains(accountIDs, id) {
+			mapped[PluginID(id)] = true
+		}
+	}
+	if err := cleanPluginLoginRecords(owned); err != nil {
+		return err
+	}
+	f, err := read()
+	if err != nil {
+		return err
+	}
+	n := len(f.Providers)
+	f.Providers = slices.DeleteFunc(f.Providers, func(p Provider) bool { return mapped[p.ID] && !hasEndpoint(p) })
+	before := len(f.Order)
+	f.Order = slices.DeleteFunc(f.Order, func(id string) bool { return mapped[id] })
+	if n != len(f.Providers) || before != len(f.Order) {
+		if err := store(f); err != nil {
+			return err
+		}
+	}
+	ForgetAccounts()
+	return nil
+}
+
+func cleanPluginLoginRecords(owned map[string]bool) error {
+	loginsMu.Lock()
+	defer loginsMu.Unlock()
+	data, err := steady.ReadFile(loginsPath())
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	var ls []savedLogin
+	if err := json.Unmarshal(data, &ls); err != nil {
+		return err // never replace an unreadable credential store
+	}
+	n := len(ls)
+	ls = slices.DeleteFunc(ls, func(l savedLogin) bool { return owned[l.Agent] })
+	if len(ls) != n {
+		if err := writeLogins(ls); err != nil {
+			return err
+		}
+	}
+	for key := range pluginSignInSaid {
+		agent, _, _ := strings.Cut(key, "/")
+		if owned[agent] {
+			delete(pluginSignInSaid, key)
+		}
+	}
+	return nil
+}
diff --git a/internal/provider/plugin_cleanremove_test.go b/internal/provider/plugin_cleanremove_test.go
new file mode 100644
index 0000000..a7e7a57
--- /dev/null
+++ b/internal/provider/plugin_cleanremove_test.go
@@ -0,0 +1,60 @@
+package provider
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+func TestCleanRemovedPluginMetadata(t *testing.T) {
+	claudeHome(t)
+	if err := writeLogins([]savedLogin{
+		{Agent: "plugin:claude-web", User: "removed", Home: "claude-web#two"},
+		{Agent: "plugin:other", User: "kept", Home: "other"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := store(file{Providers: []Provider{{ID: "claude-web", Name: "removed override"}, {ID: "other", Name: "kept override"}}, Order: []string{"claude-web", "other"}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := cleanRemovedPluginMetadata([]string{"claude-web"}); err != nil {
+		t.Fatal(err)
+	}
+	if ls := readLogins(); len(ls) != 1 || ls[0].Agent != "plugin:other" {
+		t.Fatalf("account metadata survived or another account was removed: %+v", ls)
+	}
+	f := load()
+	if len(f.Providers) != 1 || f.Providers[0].ID != "other" || !slices.Equal(f.Order, []string{"other"}) {
+		t.Fatalf("provider metadata survived or another provider was removed: %+v", f)
+	}
+}
+
+func TestCleanRemovalKeepsCustomProviderWithSameID(t *testing.T) {
+	claudeHome(t)
+	if err := store(file{Providers: []Provider{{ID: "claude-web", Chat: "https://example.invalid/v1"}, {ID: "claude-web-plugin"}}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := cleanRemovedPluginMetadata([]string{"claude-web"}); err != nil {
+		t.Fatal(err)
+	}
+	if f := load(); len(f.Providers) != 1 || f.Providers[0].ID != "claude-web" || !hasEndpoint(f.Providers[0]) {
+		t.Fatalf("custom provider was deleted: %+v", f)
+	}
+}
+
+func TestCleanRemovalRefusesUnreadableLogins(t *testing.T) {
+	claudeHome(t)
+	if err := os.MkdirAll(filepath.Dir(loginsPath()), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(loginsPath(), []byte("{broken"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := cleanRemovedPluginMetadata([]string{"claude-web"}); err == nil {
+		t.Fatal("corrupt login store was treated as empty")
+	}
+	if b, _ := os.ReadFile(loginsPath()); string(b) != "{broken" {
+		t.Fatal("login store was overwritten")
+	}
+}
