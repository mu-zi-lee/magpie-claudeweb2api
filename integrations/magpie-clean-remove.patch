index 0000000..b337a65
--- /dev/null
+++ b/internal/plugin/cleanremove.go
@@ -0,0 +1,258 @@
+package plugin
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"io"
+	"maps"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/steady"
+)
+
+// Opt-in only: removing existing plugins keeps its established semantics.
+// No plugin-controlled directory is recursively removed. Bun owns package files.
+func cleanRemoveProviders(e Entry) ([]string, error) {
+	if len(e.CleanupProviders) > 0 {
+		return slices.Clone(e.CleanupProviders), nil
+	}
+	target := Target(e.Spec)
+	info, err := os.Stat(target)
+	if os.IsNotExist(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() {
+		return nil, nil
+	}
+	data, err := os.ReadFile(filepath.Join(target, "package.json"))
+	if os.IsNotExist(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var manifest struct {
+		Magpie struct {
+			CleanRemove *struct {
+				Providers []string `json:"providers"`
+			} `json:"cleanRemove"`
+		} `json:"magpie"`
+	}
+	if err = json.Unmarshal(data, &manifest); err != nil {
+		return nil, err
+	}
+	if manifest.Magpie.CleanRemove == nil {
+		return nil, nil
+	}
+	ids := manifest.Magpie.CleanRemove.Providers
+	if len(ids) == 0 {
+		return nil, fmt.Errorf("cleanRemove requires at least one provider")
+	}
+	valid := regexp.MustCompile(`^[a-z0-9][a-z0-9._-]{0,127}$`)
+	for _, id := range ids {
+		if !valid.MatchString(id) {
+			return nil, fmt.Errorf("invalid cleanup provider id")
+		}
+	}
+	return slices.Compact(ids), nil
+}
+
+// Dispose every generation owned by this process: an update can leave the old
+// host finishing a stream, including a native executable Windows cannot delete.
+func disposeRemovedPlugin(ctx context.Context, spec string, providers []string) error {
+	ctx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	if err := Call(ctx, "validateRemoval", map[string]any{"spec": spec, "providers": providers}, nil); err != nil {
+		return err
+	}
+	if err := Call(ctx, "dispose", map[string]any{"spec": spec}, nil); err != nil {
+		return err
+	}
+	hostMu.Lock()
+	old := make([]*host, 0, len(retiring))
+	for h := range retiring {
+		if slices.ContainsFunc(h.loaded, func(l Loaded) bool { return l.Spec == spec }) {
+			old = append(old, h)
+		}
+	}
+	hostMu.Unlock()
+	for _, h := range old {
+		if err := h.call(ctx, "dispose", map[string]any{"spec": spec}, nil); err != nil && h.alive() {
+			return err
+		}
+	}
+	return Call(ctx, "uninstall", map[string]any{"spec": spec, "providers": providers}, nil)
+}
+
+// The provider layer owns account display metadata; it installs this callback
+// without creating a plugin -> provider import cycle. Errors keep registration.
+var CleanRemoved = func(providers []string) error { return nil }
+
+// Package-only cache entries are removed by exact package name. No shared cache
+// or user-supplied directory is removed. Local development sources are untouched.
+func purgeRemovedPackageCache(spec string) error {
+	if IsPath(spec) || IsGit(spec) {
+		return nil
+	}
+	name := Name(spec)
+	root := filepath.Join(appdir.Cache(), "bun", "install-cache")
+	parent := root
+	base := name
+	if scope, pkg, ok := strings.Cut(name, "/"); ok {
+		parent = filepath.Join(root, scope)
+		base = pkg
+	}
+	entries, err := os.ReadDir(parent)
+	if err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	for _, entry := range entries {
+		n := entry.Name()
+		if n == base || strings.HasPrefix(n, base+"@") || n == base+".npm" {
+			if err := os.RemoveAll(filepath.Join(parent, n)); err != nil {
+				return err
+			}
+		}
+	}
+	// Bun's registry manifests live at the root even for scoped packages, under
+	// hashed filenames. Read the format's actual package name, never search its
+	// dependencies for a substring that could delete another package's cache.
+	entries, err = os.ReadDir(root)
+	if err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".npm") {
+			continue
+		}
+		p := filepath.Join(root, entry.Name())
+		owner, err := bunManifestOwner(p)
+		if err != nil {
+			return fmt.Errorf("could not verify Bun download index ownership: %w", err)
+		}
+		if owner == name {
+			if err := os.Remove(p); err != nil {
+				return err
+			}
+		}
+	}
+	npmMu.Lock()
+	defer npmMu.Unlock()
+	// A missing Bun download directory doesn't imply the registry metadata is
+	// gone. Validate its shared file before changing it; don't discard others.
+	data, err := steady.ReadFile(npmCacheFile())
+	persisted := map[string]npmEntry{}
+	if err == nil {
+		if err := json.Unmarshal(data, &persisted); err != nil {
+			return err
+		}
+	} else if !os.IsNotExist(err) {
+		return err
+	}
+	if npmCache != nil {
+		persisted = maps.Clone(npmCache)
+	}
+	if _, ok := persisted[name]; !ok {
+		return nil
+	}
+	delete(persisted, name)
+	data, err = json.Marshal(persisted)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(npmCacheFile()), 0o755); err != nil {
+		return err
+	}
+	if err := writeWhole(npmCacheFile(), append(data, '\n')); err != nil {
+		return err
+	}
+	npmCache = persisted
+	return nil
+}
+
+// Bun 1.4.2 serializes this v0.0.7 format on every supported 64-bit target.
+// src/install/npm.rs pins NpmPackage to 120 bytes, aligned to 8. The package
+// name's SemverString is at 104; the string buffer follows its size at 192.
+// Reject unfamiliar formats rather than silently leaving plugin downloads.
+func bunManifestOwner(path string) (string, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	var header [200]byte
+	if _, err := io.ReadFull(f, header[:]); err != nil {
+		return "", err
+	}
+	if !bytes.HasPrefix(header[:], []byte("#!/usr/bin/env bun\nbun-npm-manifest-cache-v0.0.7\n")) {
+		return "", fmt.Errorf("unsupported Bun manifest format")
+	}
+	var name string
+	if header[111]&0x80 == 0 {
+		name = string(bytes.TrimRight(header[104:112], "\x00"))
+	} else {
+		off := uint64(binary.LittleEndian.Uint32(header[104:108]))
+		size := uint64(binary.LittleEndian.Uint32(header[108:112]) & 0x7fffffff)
+		stringsSize := binary.LittleEndian.Uint64(header[192:200])
+		if size == 0 || size > 214 || off+size > stringsSize || stringsSize > 64<<20 {
+			return "", fmt.Errorf("invalid Bun manifest name")
+		}
+		if _, err := f.Seek(int64(200+off), io.SeekStart); err != nil {
+			return "", err
+		}
+		buf := make([]byte, size)
+		if _, err := io.ReadFull(f, buf); err != nil {
+			return "", err
+		}
+		name = string(buf)
+	}
+	if !pkgName.MatchString(name) {
+		return "", fmt.Errorf("invalid Bun manifest package name")
+	}
+	return name, nil
+}
+
+func purgeRemovedProviderCache(spec string) error {
+	provWriteMu.Lock()
+	defer provWriteMu.Unlock()
+	provMu.Lock()
+	provEpoch++
+	if provCancel != nil {
+		provCancel()
+	}
+	// Read the persisted catalog too; the process may never have listed providers.
+	ps := provCache
+	if ps == nil {
+		if data, err := steady.ReadFile(providersPath()); err == nil {
+			if err = json.Unmarshal(data, &ps); err != nil {
+				provMu.Unlock()
+				return err
+			}
+		} else if !os.IsNotExist(err) {
+			provMu.Unlock()
+			return err
+		}
+	}
+	kept := slices.DeleteFunc(slices.Clone(ps), func(p Provider) bool { return p.Spec == spec })
+	provCache = kept
+	provGood = false
+	provTried = false
+	provMu.Unlock()
+	data, err := json.Marshal(kept)
+	if err != nil {
+		return err
+	}
+	return writeWhole(providersPath(), append(data, '\n'))
+}
