+package plugin
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestCleanRemoveInFlightListingCannotRestoreCatalog(t *testing.T) {
+	cleanSandbox(t)
+	entered, release := make(chan struct{}), make(chan struct{})
+	var enteredOnce, releaseOnce sync.Once
+	unlock := func() { releaseOnce.Do(func() { close(release) }) }
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		enteredOnce.Do(func() { close(entered) })
+		select {
+		case <-release:
+		case <-r.Context().Done():
+		}
+		w.Write([]byte("{}"))
+	}))
+	defer server.Close()
+	defer unlock()
+	const pkg = "magpie-clean-inflight"
+	cleanFixture(t, pkg, "claude-web")
+	if err := os.WriteFile(filepath.Join(Dir(), "package.json"), []byte(`{"dependencies":{"magpie-clean-inflight":"0.1.0"}}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := save(List{Plugins: []Entry{{Spec: pkg, Options: map[string]any{"provider": "claude-web", "marker": filepath.Join(t.TempDir(), "disposed"), "delay": server.URL}}}}); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	finished := make(chan error, 1)
+	go func() {
+		_, err := Providers(ctx)
+		finished <- err
+	}()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("model listing did not reach the fixture")
+	}
+	if err := Remove(ctx, pkg); err != nil {
+		t.Fatal(err)
+	}
+	unlock()
+	select {
+	case err := <-finished:
+		if err != nil {
+			t.Fatal("test requires the old listing to finish successfully", err)
+		}
+	case <-ctx.Done():
+		t.Fatal("old listing did not finish")
+	}
+	if data, err := os.ReadFile(providersPath()); err != nil || strings.Contains(string(data), "claude-web") {
+		t.Fatalf("a late response restored the removed model catalog: %s %v", data, err)
+	}
+}
