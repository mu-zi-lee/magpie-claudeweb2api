+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+)
+
+func cleanFixture(t *testing.T, pkg, id string) string {
+	t.Helper()
+	target := Target(pkg)
+	if err := os.MkdirAll(target, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	manifest := map[string]any{"name": pkg, "version": "0.1.0", "type": "module", "main": "index.mjs", "magpie": map[string]any{"cleanRemove": map[string]any{"providers": []string{id}}}}
+	raw, _ := json.Marshal(manifest)
+	if err := os.WriteFile(filepath.Join(target, "package.json"), raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	script := `import fs from 'node:fs';
+ export default {id:'fixture',async server(input,options){
+  if(input.magpie.cleanRemove!==1) throw Error('missing lifecycle capability');
+  if(typeof input.magpie.proxyFor!=='function') throw Error('missing proxy capability');
+  return {
+   config:async cfg=>{cfg.provider??={};cfg.provider[options.provider]={name:'fixture',npm:'@ai-sdk/anthropic',api:'https://example.invalid/v1',models:{}}},
+   auth:{provider:options.provider,methods:[{type:'api',label:'test'}]},
+   provider:{id:options.provider,async models(p){if(options.delay)await fetch(options.delay);return p.models}},
+   'magpie.uninstall':async()=>{if(options.fail)throw Error('cleanup failed');fs.writeFileSync(options.marker,'disposed')}
+  }
+ }};`
+	if err := os.WriteFile(filepath.Join(target, "index.mjs"), []byte(script), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return target
+}
+
+func cleanSandbox(t *testing.T) {
+	t.Helper()
+	sandbox(t)
+	Settle()
+	provMu.Lock()
+	provCache = nil
+	provGood, provTried = false, false
+	provMu.Unlock()
+	ReloadInfo()
+	t.Cleanup(ReloadInfo)
+}
+
+func TestCleanRemoveOwnedState(t *testing.T) {
+	cleanSandbox(t)
+	const pkg = "magpie-clean-remove-fixture"
+	target := cleanFixture(t, pkg, "claude-web")
+	marker := filepath.Join(t.TempDir(), "disposed")
+	// Bun receives a real installed package with no external dependencies.
+	raw, _ := json.Marshal(map[string]any{"dependencies": map[string]string{pkg: "0.1.0"}})
+	if err := os.WriteFile(filepath.Join(Dir(), "package.json"), raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	l := List{Plugins: []Entry{{Spec: pkg, Options: map[string]any{"provider": "claude-web", "marker": marker}}}, Config: map[string]any{"provider": map[string]any{"claude-web": map[string]any{"name": "owned"}, "other": map[string]any{"name": "kept"}}}}
+	if err := save(l); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(AuthPath(), []byte(`{"claude-web":{"type":"api","key":"owned"},"claude-web#two":{"type":"api","key":"owned-two"},"other":{"type":"api","key":"keep"}}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cache, _ := json.Marshal([]Provider{{ID: "claude-web", Spec: pkg}, {ID: "other", Spec: "other-plugin"}})
+	if err := os.WriteFile(providersPath(), cache, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cacheRoot := filepath.Join(appdir.Cache(), "bun", "install-cache")
+	ownedCache := filepath.Join(cacheRoot, pkg+"@0.1.0@@@1")
+	neighborCache := filepath.Join(cacheRoot, pkg+"-neighbor@0.1.0@@@1")
+	for _, p := range []string{ownedCache, neighborCache} {
+		if err := os.MkdirAll(p, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(p, "binary"), []byte("downloaded"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	if err := Remove(ctx, pkg); err != nil {
+		t.Fatal(err)
+	}
+	if b, err := os.ReadFile(marker); err != nil || string(b) != "disposed" {
+		t.Fatal("cleanup callback did not run", err)
+	}
+	if _, err := os.Stat(target); !os.IsNotExist(err) {
+		t.Fatal("managed plugin package survived", err)
+	}
+	if _, err := os.Stat(ownedCache); !os.IsNotExist(err) {
+		t.Fatal("download cache survived", err)
+	}
+	if _, err := os.Stat(neighborCache); err != nil {
+		t.Fatal("another plugin's cache was removed", err)
+	}
+	auth, err := os.ReadFile(AuthPath())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(auth), "claude-web") || !strings.Contains(string(auth), "keep") {
+		t.Fatalf("wrong account cleanup: %s", auth)
+	}
+	cache, err = os.ReadFile(providersPath())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(cache), pkg) || !strings.Contains(string(cache), "other-plugin") {
+		t.Fatalf("wrong cache cleanup: %s", cache)
+	}
+	l = Load()
+	if len(l.Plugins) != 0 || l.Config["provider"].(map[string]any)["claude-web"] != nil || l.Config["provider"].(map[string]any)["other"] == nil {
+		t.Fatalf("wrong list cleanup: %+v", l)
+	}
+}
+
+func TestCleanRemoveFailureKeepsRegistrationAndAuth(t *testing.T) {
+	cleanSandbox(t)
+	const pkg = "magpie-clean-remove-failure"
+	target := cleanFixture(t, pkg, "claude-web")
+	if err := save(List{Plugins: []Entry{{Spec: pkg, Options: map[string]any{"provider": "claude-web", "fail": true}}}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(AuthPath(), []byte(`{"claude-web":{"type":"api","key":"owned"}}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if err := Remove(ctx, pkg); err == nil {
+		t.Fatal("cleanup failure reported success")
+	}
+	if len(Load().Plugins) != 1 {
+		t.Fatal("failed cleanup unregistered the package")
+	}
+	if _, err := os.Stat(target); err != nil {
+		t.Fatal("failed cleanup deleted the package")
+	}
+	auth, _ := os.ReadFile(AuthPath())
+	if !strings.Contains(string(auth), "owned") {
+		t.Fatal("auth deleted before successful cleanup")
+	}
+}
+
+func TestCleanRemoveRefusesSharedProvider(t *testing.T) {
+	cleanSandbox(t)
+	first := cleanFixture(t, "magpie-clean-one", "shared")
+	second := cleanFixture(t, "magpie-clean-two", "shared")
+	if err := save(List{Plugins: []Entry{{Spec: first, Options: map[string]any{"provider": "shared"}}, {Spec: second, Options: map[string]any{"provider": "shared"}}}}); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if err := Remove(ctx, first); err == nil || !strings.Contains(err.Error(), "shared") {
+		t.Fatalf("shared provider cleanup: %v", err)
+	}
+	if len(Load().Plugins) != 2 {
+		t.Fatal("another plugin was removed")
+	}
+}
+
+func TestCleanRemoveRegistryMetadataWithoutDownloadDirectory(t *testing.T) {
+	cleanSandbox(t)
+	ReloadInfo()
+	t.Cleanup(ReloadInfo)
+	if err := os.MkdirAll(filepath.Dir(npmCacheFile()), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	const pkg = "magpie-clean-registry-fixture"
+	data, _ := json.Marshal(map[string]npmEntry{pkg: {Info: NPM{Version: "0.1.0"}}, "other": {Info: NPM{Version: "1.0.0"}}})
+	if err := os.WriteFile(npmCacheFile(), data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := purgeRemovedPackageCache(pkg); err != nil {
+		t.Fatal(err)
+	}
+	ReloadInfo()
+	if got := InfoCached([]string{pkg, "other"}); len(got) != 1 || got["other"].Version != "1.0.0" {
+		t.Fatalf("registry cache cleanup: %+v", got)
+	}
+}
+
+func TestCleanRemoveRefusesUnreadableAuth(t *testing.T) {
+	cleanSandbox(t)
+	const pkg = "magpie-clean-corrupt-auth"
+	target := cleanFixture(t, pkg, "claude-web")
+	if err := save(List{Plugins: []Entry{{Spec: pkg, Options: map[string]any{"provider": "claude-web", "marker": filepath.Join(t.TempDir(), "disposed")}}}}); err != nil {
+		t.Fatal(err)
+	}
+	const corrupt = `{"claude-web":{"key":"fixture"},broken`
+	if err := os.WriteFile(AuthPath(), []byte(corrupt), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if err := Remove(ctx, pkg); err == nil || !strings.Contains(err.Error(), "unreadable") {
+		t.Fatalf("corrupt account store reported successful removal: %v", err)
+	}
+	if b, _ := os.ReadFile(AuthPath()); string(b) != corrupt {
+		t.Fatal("unreadable shared auth was overwritten")
+	}
+	if _, err := os.Stat(target); err != nil || len(Load().Plugins) != 1 {
+		t.Fatal("failed cleanup lost package or registration", err)
+	}
+}
+
+func TestCleanRemoveActualBunDownloadIndexes(t *testing.T) {
+	for _, pkg := range []string{"magpie-clean-download", "@magpie-clean/download"} {
+		t.Run(pkg, func(t *testing.T) {
+			cleanSandbox(t)
+			heldRegistry(t, pkg, map[string]time.Time{"0.1.0": time.Now().Add(-72 * time.Hour)}, "0.1.0")
+			ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+			defer cancel()
+			if err := install(ctx, pkg+"@0.1.0"); err != nil {
+				t.Fatal(err)
+			}
+			root := filepath.Join(appdir.Cache(), "bun", "install-cache")
+			entries, err := os.ReadDir(root)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var indexes []string
+			for _, e := range entries {
+				if strings.HasSuffix(e.Name(), ".npm") {
+					p := filepath.Join(root, e.Name())
+					owner, err := bunManifestOwner(p)
+					if err != nil || owner != pkg {
+						t.Fatalf("actual Bun manifest owner = %q: %v", owner, err)
+					}
+					indexes = append(indexes, p)
+				}
+			}
+			if len(indexes) == 0 {
+				t.Fatal("Bun did not create a download index; test cannot prove cleanup")
+			}
+			cleanFixture(t, pkg, "claude-web")
+			if err := save(List{Plugins: []Entry{{Spec: pkg, Options: map[string]any{"provider": "claude-web", "marker": filepath.Join(t.TempDir(), "disposed")}}}}); err != nil {
+				t.Fatal(err)
+			}
+			Restart()
+			if err := Remove(ctx, pkg); err != nil {
+				t.Fatal(err)
+			}
+			for _, p := range indexes {
+				if _, err := os.Stat(p); !os.IsNotExist(err) {
+					t.Fatal("hashed download index survived uninstall", err)
+				}
+			}
+			entries, err = os.ReadDir(root)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, e := range entries {
+				if e.Name() == "@magpie-clean" {
+					inside, err := os.ReadDir(filepath.Join(root, e.Name()))
+					if err != nil || len(inside) != 0 {
+						t.Fatal("scoped download files survived", err)
+					}
+				} else {
+					t.Fatalf("download cache entry survived: %s", e.Name())
+				}
+			}
+		})
+	}
+}
