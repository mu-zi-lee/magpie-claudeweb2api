{
  "name": "magpie-claudeweb2api",
  "version": "0.1.0",
  "description": "Isolated Claude web provider for Magpie, with a managed Go transport",
  "type": "module",
  "main": "./src/index.mjs",
  "files": ["src", "bin", "assets/icon.png", "assets/icon-small.png", "docs", "integrations/README.md", "integrations/magpie-base.json", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all",
    "test": "node --test test/*.test.mjs",
    "test:magpie": "node scripts/test-magpie.mjs",
    "test:go": "cd backend && go test -race ./...",
    "check": "node scripts/check-package.mjs",
    "prepack": "node scripts/check-package.mjs"
  },
  "keywords": ["magpie", "opencode-plugin", "claude", "claude-web"],
  "license": "MIT",
  "magpie": {
    "maxConcurrency": 1
  }
}
